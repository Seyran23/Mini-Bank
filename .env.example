# ─── Docker Compose ──────────────────────────────────────────────────────────
POSTGRES_USER=minibank
POSTGRES_PASSWORD=minibank
RABBITMQ_USER=minibank
RABBITMQ_PASSWORD=minibank

# ─── Auth Service ─────────────────────────────────────────────────────────────
AUTH_DATABASE_URL=postgresql://minibank:minibank@localhost:5435/auth_db

# JWT RS256
AUTH_JWT_ACCESS_PRIVATE_KEY_BASE64=
AUTH_JWT_ACCESS_PUBLIC_KEY_BASE64=
AUTH_JWT_REFRESH_PRIVATE_KEY_BASE64=
AUTH_JWT_REFRESH_PUBLIC_KEY_BASE64=
AUTH_JWT_ACCESS_EXPIRES_IN=15m
AUTH_JWT_REFRESH_EXPIRES_IN=7d

AUTH_PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Shared secret for service-to-service calls 
AUTH_INTERNAL_API_KEY=

# ─── Accounts Service ─────────────────────────────────────────────────────────
ACCOUNTS_DATABASE_URL=postgresql://minibank:minibank@localhost:5433/accounts_db
ACCOUNTS_PORT=3002

ACCOUNTS_JWT_ACCESS_PUBLIC_KEY_BASE64=

# Shared secret for service-to-service calls 
ACCOUNTS_INTERNAL_API_KEY=

# ─── Transfers Service ────────────────────────────────────────────────────────
TRANSFERS_DATABASE_URL=postgresql://minibank:minibank@localhost:5434/transfers_db
TRANSFERS_PORT=3003

TRANSFERS_JWT_ACCESS_PUBLIC_KEY_BASE64=

ACCOUNTS_SERVICE_URL=http://localhost:3002

SAGA_POLL_INTERVAL_MS=5000
OUTBOX_POLL_INTERVAL_MS=1000

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://minibank:minibank@localhost:5672

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380
REDIS_HOST=localhost
REDIS_PORT=6380

# ─── Notifications Service ────────────────────────────────────────────────────
NOTIFICATIONS_PORT=3004

AUTH_SERVICE_URL=http://localhost:3001

# Mailhog locally — no auth needed, leave SMTP_USER/SMTP_PASSWORD empty.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=notifications@minibank.local

# ─── Gateway Service ──────────────────────────────────────────────────────────
GATEWAY_PORT=3000

GATEWAY_JWT_ACCESS_PUBLIC_KEY_BASE64=

TRANSFERS_SERVICE_URL=http://localhost:3003

# Per-IP request throttling at the edge.
GATEWAY_RATE_LIMIT_MAX=100
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
